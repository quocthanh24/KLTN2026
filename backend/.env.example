APP_NAME="KLTN API"
APP_ENV=development
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
POSTGRES_USER=kltn
POSTGRES_PASSWORD=local_example_password
POSTGRES_DB=kltn
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=abc@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
DATABASE_URL=postgresql+asyncpg://kltn:local_example_password@127.0.0.1:5432/kltn
FRONTEND_URL=http://localhost:3000
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Generate a random local key; never commit the actual value.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false

# Docker Compose MinIO; backend runs on the Windows host.
# Replace credentials locally; never commit real values.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=replace_with_local_access_key
OBJECT_STORAGE_SECRET_KEY=replace_with_local_secret_key
OBJECT_STORAGE_BUCKET=chat-attachments
OBJECT_STORAGE_SECURE=false
ATTACHMENT_MAX_SIZE_BYTES=26214400
# Local E5 ONNX model directory; never downloaded by the request/worker.
RAG_MODEL_DIR=
RAG_PROCESSING_TIMEOUT_SECONDS=120
# Dedicated empty PostgreSQL database for foundation tests; never use kltn here.
TEST_DATABASE_URL=postgresql+asyncpg://kltn:local_example_password@127.0.0.1:5432/kltn_test

# Phase 6: OpenAI (backend only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=60
AI_PROVIDER=openai
# Bounded planner + generation + verification for one turn (no new service).
AI_TURN_MAX_CALLS=24
AI_TURN_TIMEOUT_SECONDS=240
AI_CHAT_V2_MAX_IMAGES=24
AI_CHAT_V2_SOURCE_REPAIR_ATTEMPTS=2

# Multimodal PDF/DOCX embedded images: existing backend OpenAI key/model, never frontend.
DOCUMENT_VISION_ENABLED=true
DOCUMENT_VISION_MAX_PAGES=32
DOCUMENT_VISION_MAX_CALLS=32
DOCUMENT_VISION_MAX_PIXELS=4000000
DOCUMENT_VISION_OUTPUT_TOKENS=4096
# Durable global daily cap (failed/unknown requests count); UTC day.
DOCUMENT_VISION_DAILY_CALL_CAP=60
# Optional absolute path for a shared local SQLite ledger (single-host).
# DOCUMENT_VISION_LEDGER=

# Normal chat uses the backend API key, billed according to actual usage.
AI_CHAT_BILLING_MODE=metered
# The following grant settings apply only when AI_CHAT_BILLING_MODE=capped.
AI_CHAT_V2_LIVE_APPROVED=false
# Default-denied: provision an immutable scoped approval only after owner budget approval.
AI_CHAT_V2_BUDGET_APPROVAL_ID=
AI_CHAT_V2_BUDGET_TOPOLOGY=single_host
AI_CHAT_V2_VISION_READY=true
AI_CHAT_V2_ORIGINAL_FIRST=true
# Requires additive document_derivations migration before starting the worker.
# Never runs upload-time OCR; per-unit native navigation index, original read on demand.
DOCUMENT_PROGRESSIVE_ENABLED=true
AI_CHAT_V2_JOB_TTL_HOURS=24
AI_CHAT_V2_WORKER_CONCURRENCY=2
