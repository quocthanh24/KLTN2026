{
    "name": "kltn-account-frontend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev --hostname 0.0.0.0",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/chat.test.cjs tests/study-room.test.cjs tests/workspace-invitations.test.cjs tests/pomodoro.test.cjs tests/learning-documents.test.cjs tests/learning-analytics.test.cjs",
        "test:documents-live": "node tests/learning-documents-live.cjs",
        "test:documents-browser": "node tests/learning-documents-browser.cjs",
        "test:pomodoro-live": "node tests/pomodoro-live.cjs",
        "test:browser": "node tests/chat-browser.cjs",
        "test:live": "node tests/chat-live.cjs",
        "test:media-live": "node tests/media-live.cjs",
        "test:screen-live": "node tests/media-live.cjs --screen-share",
        "test:member-status-live": "node tests/media-live.cjs --screen-share --member-status",
        "test:invitation-live": "node tests/invitation-live.cjs",
        "prebuild": "node scripts/copy-pdf-worker.mjs",
        "predev": "node scripts/copy-pdf-worker.mjs",
