    "dependencies": {
        "livekit-client": "2.17.2",
        "next": "^16.3.6",
        "pdfjs-dist": "^6.4.299",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "eslint": "^9.0.0",
        "eslint-config-next": "^16.0.0",
        "typescript": "^5.0.0"
    }
}
